# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=
WEAVIATE_URL=
WEAVIATE_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback/
GMAIL_PUBSUB_TOPIC=projects/<your-project-id>/topics/clarivo-gmail
GMAIL_PUSH_ENABLED=True
GMAIL_PUSH_SECRET=<the token_urlsafe value>
FIELD_ENCRYPTION_KEY=<the Fernet key>
FRONTEND_URL=http://localhost:5173
PUBLIC_HOSTNAME=<your-domain>.ngrok-free.app